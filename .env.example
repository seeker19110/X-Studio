# Thư mục lưu token/pid/log của gateway (mặc định: ~/.x-agents/gateway)
# XAGENTS_HOME=

# Ghi đè OAuth client (hiếm khi cần — mặc định dùng client công khai của Antigravity IDE)
# GATEWAY_ANTIGRAVITY_CLIENT_ID=
# GATEWAY_ANTIGRAVITY_CLIENT_SECRET=
# GATEWAY_ANTIGRAVITY_PROJECT_ID=

# Host/port gateway lắng nghe
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8100

# Phía software-company: trỏ vào gateway (hoặc chạy `make setup` để ghi llm.yaml)
# COMPANY_LLM_PROVIDER=openai
# COMPANY_LLM_BASE_URL=http://127.0.0.1:8100/v1
# COMPANY_LLM_API_KEY=gateway-local     # bất kỳ chuỗi nào; gateway tự xác thực Google bằng OAuth
# COMPANY_MODEL_STRONG=claude-sonnet-4-6
# COMPANY_MODEL_STANDARD=gemini-3.7-flash
