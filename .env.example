# File này chỉ là tài liệu: gateway KHÔNG đọc .env — export biến trong shell (hoặc set trong service) trước khi chạy.

# Thư mục gốc dữ liệu X-Agents (mặc định: ~/.x-agents); gateway dùng auth/ (token), gateway/ (pid), logs/ trong đó
# XAGENTS_HOME=

# Ghi đè OAuth client (hiếm khi cần — mặc định dùng client công khai của Antigravity IDE)
# GATEWAY_ANTIGRAVITY_CLIENT_ID=
# GATEWAY_ANTIGRAVITY_CLIENT_SECRET=
# GATEWAY_ANTIGRAVITY_PROJECT_ID=

# Host/port gateway lắng nghe. Cổng 8100 có thể đã bị bridge của Plugin-For-Hermes chiếm — hai proxy
# chạy song song được, chỉ cần khác cổng (mỗi bên đọc file token riêng; xem README §"Cổng 8100 đã có người giữ"):
#   python -m gateway start --port 8101
# rồi trỏ base_url của các công ty vào đúng cổng đó. Kiểm tra ai đang giữ cổng: `curl -s :PORT/health`
# — gateway trả {"service":"gateway"}, bridge Hermes trả {"bridge":"antigravity"}.
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8100

# Phía software-company: trỏ vào gateway (hoặc chạy `make setup` để ghi llm.yaml)
# COMPANY_LLM_PROVIDER=openai
# COMPANY_LLM_BASE_URL=http://127.0.0.1:8100/v1     # đổi cổng nếu gateway chạy ở cổng khác
# COMPANY_LLM_API_KEY=gateway-local     # bất kỳ chuỗi nào; gateway tự xác thực Google bằng OAuth
# COMPANY_MODEL_STRONG=claude-sonnet-4-6
# COMPANY_MODEL_STANDARD=gemini-3.8-flash-medium    # xem id thật: python -m gateway models

# Model lạ: 1 (mặc định) = trả HTTP 400; 0 = fallback về model mặc định kèm warning trong log
# GATEWAY_STRICT_MODELS=1

# Phiên bản client khai với Code Assist. Khai quá cũ thì server GIẤU model mới (trả 404 y như model
# không tồn tại) — chỉ đổi khi biết chắc mình đang làm gì.
# GATEWAY_ANTIGRAVITY_CLIENT_VERSION=2026.9.1
