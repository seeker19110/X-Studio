{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/scene-manifests",
  "title": "scene-manifests",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "scene-manifests"
    },
    "key": {
      "type": "string",
      "description": "= video_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    },
    "payload": {
      "description": "Bản ghi bền vững của một sản xuất (ADR-0004): sửa một cảnh không phải làm lại cả video.",
      "properties": {
        "video_id": {
          "type": "string"
        },
        "version": {
          "default": 1,
          "type": "integer"
        },
        "script_version": {
          "default": 1,
          "type": "integer"
        },
        "scenes": {
          "items": {
            "properties": {
              "scene_id": {
                "type": "string"
              },
              "order": {
                "type": "integer"
              },
              "narration": {
                "type": "string"
              },
              "visual_prompt": {
                "type": "string"
              },
              "duration_s": {
                "default": 6.0,
                "type": "number"
              },
              "locked": {
                "default": false,
                "type": "boolean"
              },
              "asset_refs": {
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "type": "object"
              },
              "graphic": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "template": {
                        "default": "title",
                        "enum": [
                          "title",
                          "quote",
                          "bars",
                          "list",
                          "stat"
                        ],
                        "title": "Template",
                        "type": "string",
                        "description": "title: tiêu đề chương · quote: câu trích + người nói ở subtitle · bars: so sánh ≤6 số (labels+values+source) · list: 2–6 ý ngắn hiện lần lượt · stat: một con số lớn (values[0], unit, source)"
                      },
                      "title": {
                        "maxLength": 160,
                        "minLength": 1,
                        "title": "Title",
                        "type": "string"
                      },
                      "subtitle": {
                        "default": "",
                        "maxLength": 240,
                        "title": "Subtitle",
                        "type": "string"
                      },
                      "accent": {
                        "default": "55DDB0",
                        "pattern": "^[0-9A-Fa-f]{6}$",
                        "title": "Accent",
                        "type": "string"
                      },
                      "background": {
                        "default": "101F29",
                        "pattern": "^[0-9A-Fa-f]{6}$",
                        "title": "Background",
                        "type": "string"
                      },
                      "labels": {
                        "items": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "maxItems": 6,
                        "title": "Labels",
                        "type": "array"
                      },
                      "values": {
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "maxItems": 6,
                        "title": "Values",
                        "type": "array"
                      },
                      "unit": {
                        "default": "",
                        "maxLength": 12,
                        "title": "Unit",
                        "type": "string"
                      },
                      "source": {
                        "default": "",
                        "maxLength": 200,
                        "title": "Source",
                        "type": "string"
                      }
                    },
                    "required": [
                      "title"
                    ],
                    "type": "object",
                    "description": "ADR-0017: đồ họa dữ liệu của cảnh (template), null = cảnh dùng ảnh/footage. Số trên bars/stat phải có nguồn."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "scene_id",
              "order",
              "narration",
              "visual_prompt"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "voice": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "aspect": {
          "default": "16:9",
          "enum": [
            "16:9",
            "9:16"
          ],
          "type": "string"
        },
        "cinema": {
          "type": "object",
          "properties": {
            "production_type": {
              "default": "explainer",
              "enum": [
                "explainer",
                "film",
                "animation"
              ],
              "title": "Production Type",
              "type": "string"
            },
            "visual_mode": {
              "default": "images",
              "enum": [
                "images",
                "generated_video"
              ],
              "title": "Visual Mode",
              "type": "string"
            },
            "visual_style": {
              "default": "",
              "maxLength": 1000,
              "title": "Visual Style",
              "type": "string"
            },
            "logline": {
              "default": "",
              "maxLength": 1500,
              "title": "Logline",
              "type": "string"
            },
            "character_bible": {
              "default": "",
              "maxLength": 3000,
              "title": "Character Bible",
              "type": "string"
            },
            "negative_prompt": {
              "default": "",
              "maxLength": 1000,
              "title": "Negative Prompt",
              "type": "string"
            },
            "seed": {
              "default": 0,
              "maximum": 2147483647,
              "minimum": 0,
              "title": "Seed",
              "type": "integer"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "video_id",
        "scenes"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
