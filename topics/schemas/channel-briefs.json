{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/channel-briefs",
  "title": "channel-briefs",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "channel-briefs"
    },
    "key": {
      "type": "string",
      "description": "= channel_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audience": {
          "type": "string"
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cadence": {
          "type": "string"
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "goals",
        "audience",
        "pillars"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
