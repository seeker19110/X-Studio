{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/trend-reports",
  "title": "trend-reports",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "trend-reports"
    },
    "key": {
      "type": "string",
      "description": "= channel_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "trends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string"
              },
              "momentum": {
                "enum": [
                  "rising",
                  "stable",
                  "falling"
                ]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "topic",
              "momentum",
              "evidence"
            ]
          }
        },
        "opportunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "channel_id",
        "trends",
        "sources"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
