{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/publish-events",
  "title": "publish-events",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "publish-events"
    },
    "key": {
      "type": "string",
      "description": "= video_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "properties": {
        "video_id": {
          "type": "string"
        },
        "kind": {
          "default": "video",
          "enum": [
            "video",
            "reply"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "scheduled",
            "published",
            "failed",
            "rolled_back"
          ],
          "type": "string"
        },
        "scheduled_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "platform_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "status"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
