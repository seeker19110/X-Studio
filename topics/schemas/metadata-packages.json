{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/metadata-packages",
  "title": "metadata-packages",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "metadata-packages"
    },
    "key": {
      "type": "string",
      "description": "= video_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    },
    "payload": {
      "properties": {
        "video_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "chapters": {
          "default": [],
          "items": {
            "properties": {
              "time": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "time",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "primary_keyword": {
          "default": "",
          "type": "string"
        },
        "language": {
          "default": "vi",
          "type": "string"
        },
        "category": {
          "default": "",
          "type": "string"
        },
        "alt_titles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "synthetic_media": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "ADR-0018: khai `containsSyntheticMedia` khi đăng; code điền từ manifest/provenance hoặc production.synthetic_media; null = chưa quyết"
        },
        "paid_product_placement": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "ADR-0018: khai `paidProductPlacementDetails.hasPaidProductPlacement` khi đăng; code điền từ production.paid_product_placement; null = chưa khai"
        }
      },
      "required": [
        "video_id",
        "title",
        "description"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
