{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/video-briefs",
  "title": "video-briefs",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "video-briefs"
    },
    "key": {
      "type": "string",
      "description": "= video_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "phiên bản envelope+payload của topic"
    },
    "correlation_id": {
      "type": "string",
      "description": "event gốc của cả chuỗi (project/ticket)"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "event trực tiếp sinh ra event này"
    },
    "payload": {
      "description": "Một video trong kế hoạch biên tập (channel-strategist tạo, human gate `plan` duyệt rồi code dispatch).",
      "properties": {
        "video_id": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "working_title": {
          "type": "string"
        },
        "pillar": {
          "type": "string"
        },
        "angle": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "format": {
          "default": "long",
          "enum": [
            "long",
            "short"
          ],
          "type": "string"
        },
        "target_minutes": {
          "default": 8.0,
          "type": "number"
        },
        "key_points": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "boundaries": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "risk_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "priority": {
          "default": 3,
          "type": "integer"
        },
        "estimate_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budget_tokens": {
          "default": 150000,
          "type": "integer"
        },
        "retry": {
          "default": 0,
          "type": "integer"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "production_type": {
          "default": "explainer",
          "enum": [
            "explainer",
            "film",
            "animation"
          ],
          "title": "Production Type",
          "type": "string"
        },
        "visual_mode": {
          "default": "images",
          "enum": [
            "images",
            "generated_video"
          ],
          "title": "Visual Mode",
          "type": "string"
        },
        "visual_style": {
          "default": "",
          "maxLength": 1000,
          "title": "Visual Style",
          "type": "string"
        },
        "logline": {
          "default": "",
          "maxLength": 1500,
          "title": "Logline",
          "type": "string"
        },
        "character_bible": {
          "default": "",
          "maxLength": 3000,
          "title": "Character Bible",
          "type": "string"
        },
        "negative_prompt": {
          "default": "",
          "maxLength": 1000,
          "title": "Negative Prompt",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "video_id",
        "channel_id",
        "working_title",
        "pillar",
        "angle",
        "audience"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
