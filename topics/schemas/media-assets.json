{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio-creators/topics/media-assets",
  "title": "media-assets",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "const": "media-assets"
    },
    "key": {
      "type": "string",
      "description": "= video_id"
    },
    "actor": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "properties": {
        "video_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "scene_audio",
            "scene_image",
            "draft_video",
            "final_video",
            "thumbnail"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_version": {
          "default": 1,
          "type": "integer"
        },
        "provider": {
          "default": "fake",
          "type": "string"
        },
        "checksum": {
          "default": "",
          "type": "string"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "properties": {
            "generated_by": {
              "type": "string"
            },
            "prompt_ref": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "license": {
              "default": "generated",
              "type": "string"
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "generated_by"
          ],
          "type": "object"
        },
        "variant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "video_id",
        "kind",
        "path",
        "provenance"
      ],
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "topic",
    "key",
    "actor",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
